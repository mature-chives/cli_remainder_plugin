{
  "description": "Notify the desktop when Codex needs attention.",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const r=process.env.PLUGIN_ROOT;require(require('path').join(r,'scripts','cli_notify.js')).main()\"",
            "timeout": 8,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const r=process.env.PLUGIN_ROOT;require(require('path').join(r,'scripts','cli_notify.js')).main()\"",
            "timeout": 8,
            "async": true
          }
        ]
      }
    ]
  }
}
